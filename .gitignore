# ============================================================
# PBL4 ChessCV - Git Ignore
# ============================================================

# Python environments
venv/
.venv/

# Python cache
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]

# Node / npm / TypeScript
node_modules/
.npm/
.yarn/
.pnpm-store/

# Build outputs
dist/
build/
out/

# Framework caches
.next/
.nuxt/
.output/
.vite/
.turbo/
.cache/
.parcel-cache/

# Testing / coverage
coverage/

# IDE
.idea/
.vscode/

# Image files
*.png

# Chess game files
*.pgn

# ============================================================
# SECURITY - Never upload credentials
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# Optional local and generated data
# ============================================================

# Python model checkpoints
*.pt
*.pth

# Temporary files
*.tmp
*.log

# ============================================================
# Numeric JSON filenames are added separately
# because .gitignore cannot express the exact Python regex.
